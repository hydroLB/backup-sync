{
  "name": "backup-sync-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "VITE_APP_RUNTIME=web vite",
    "build": "vite build",
    "build:web": "VITE_APP_RUNTIME=web vite build",
    "tauri": "cd .. && tauri dev --config tauri.conf.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" vite.config.ts vitest.config.ts vitest.setup.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"*.{ts,cjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"*.{ts,cjs,json}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest run src/**/*.test.tsx"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.61.0",
    "@cloudflare/workers-types": "5.20260928.1",
    "@eslint/js": "10.0.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/scheduler": "0.28.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.142.0"
  }
}
