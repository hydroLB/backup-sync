{
  "bundle": {
    "icon": [
      "src-tauri/icons/icon.png",
      "src-tauri/icons/icon-512.png",
      "src-tauri/icons/icon-256.png",
      "src-tauri/icons/icon-128.png"
    ]
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "productName": "Backup Sync",
  "version": "0.1.0",
  "identifier": "com.hydrolb.backupsync",
  "plugins": {},
  "app": {
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'"],
        "style-src": ["'self'"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "data:", "blob:"],
        "font-src": ["'self'", "data:"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'self'"],
        "frame-ancestors": ["'none'"]
      },
      "devCsp": {
        "default-src": ["'self'", "http://localhost:5173"],
        "script-src": ["'self'", "'unsafe-inline'", "http://localhost:5173"],
        "style-src": ["'self'", "'unsafe-inline'", "http://localhost:5173"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "http://localhost:5173",
          "ws://localhost:5173"
        ],
        "img-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "http://localhost:5173",
          "data:",
          "blob:"
        ],
        "font-src": ["'self'", "http://localhost:5173", "data:"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'self'"],
        "frame-ancestors": ["'none'"]
      }
    },
    "windows": [
      {
        "title": "Backup Sync",
        "width": 1087,
        "height": 924,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        },
        "backgroundColor": "#050a16",
        "useHttpsScheme": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "src-tauri/icons/tray.png",
      "menuOnLeftClick": true
    }
  }
}
