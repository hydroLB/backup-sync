# Backup Sync environment overrides
# Copy to `.env` for local development if your shell loader supports it.

# --- Runtime paths ---
# Optional: override daemon config path.
BACKUP_SYNC_CONFIG=

# Optional: layer interval override on top of file config (seconds, positive integer).
BACKUP_SYNC_INTERVAL_SECONDS=

# Optional: layer safe mode override on top of file config (true/false/1/0/yes/no/on/off).
BACKUP_SYNC_SAFE_MODE=

# Optional: override daemon log file path.
BACKUP_SYNC_LOG=

# Optional: override daemon executable used by service commands.
BACKUP_SYNC_DAEMON_EXEC=

# Optional: update feed location for desktop update checks.
BACKUP_SYNC_UPDATE_FEED=

# --- Development ---
# Auto-start daemon from launch script (`1` enabled, `0` disabled).
BACKUP_SYNC_AUTO_START_DAEMON=1

# Dev server port override for frontend.
BACKUP_SYNC_DEV_PORT=1420

# Alternative Vite port override if preferred.
VITE_PORT=

# Log verbosity (Rust tracing filter syntax).
RUST_LOG=info

# --- Performance gate ---
# Number of perf-check attempts before failing.
BACKUP_SYNC_PERF_ATTEMPTS=5
